{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "StreamPulse — Bloc 3 Observability",
  "uid": "streampulse-main",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Active Streams (live)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "streampulse_active_streams", "legendFormat": "streams" }
      ]
    },
    {
      "id": 2,
      "title": "Listeners online (total)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(streampulse_active_listeners)", "legendFormat": "listeners" }
      ]
    },
    {
      "id": 3,
      "title": "API request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(streampulse_http_requests_total[1m])) by (path)", "legendFormat": "{{path}}" }
      ]
    },
    {
      "id": 4,
      "title": "Error rate 5xx (technical) vs 4xx",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(rate(streampulse_http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx" },
        { "expr": "sum(rate(streampulse_http_requests_total{status=~\"4..\"}[1m]))", "legendFormat": "4xx" }
      ]
    },
    {
      "id": 5,
      "title": "API latency p95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(streampulse_http_request_duration_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}" }
      ]
    },
    {
      "id": 6,
      "title": "Listener disconnections (business metric)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 13 },
      "targets": [
        { "expr": "sum(rate(streampulse_stream_disconnections_total[5m])) by (reason)", "legendFormat": "{{reason}}" }
      ]
    }
  ]
}
